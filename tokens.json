{
  "_source": "prairiehillsgelbvieh.com",
  "_brand": "Aaron Family Livestock",
  "_extracted": "2026-05-27",
  "_note": "Fort Condensed is Adobe Fonts / Typekit — requires Adobe Fonts subscription. Free alternative: Barlow Condensed from Google Fonts.",

  "palette": {
    "--canvas-bg":      "#0A0A0A",
    "--primary":        "#500000",
    "--primary-dark":   "#380000",
    "--primary-light":  "#800000",
    "--white":          "#FFFFFF",
    "--white-muted":    "rgba(255, 255, 255, 0.66)",
    "--overlay-dark":   "rgba(0, 0, 0, 0.35)",
    "--black":          "#000000",
    "_note_colors": "AFL brand crimson from logo. Canvas near-black not pure black so logo white areas don't disappear."
  },

  "typography": {
    "--font-heading":   "'fort-condensed', 'Barlow Condensed', sans-serif",
    "--font-xcondensed":"'fort-xcondensed', 'Barlow Condensed', sans-serif",
    "--font-display":   "'Birthstone Bounce', cursive",
    "--font-body":      "'fort-condensed', 'Barlow Condensed', sans-serif",
    "--font-weight-body": "400",
    "--font-weight-nav":  "700",
    "--font-weight-cta":  "700",
    "--font-weight-display": "500",

    "--size-hero-script": "6em",
    "--size-h1":          "4em",
    "--size-h2":          "3em",
    "--size-h3":          "2em",
    "--size-nav":         "1em",
    "--size-body":        "18px",
    "--size-base":        "18px",

    "--transform-heading": "uppercase",
    "--transform-nav":     "uppercase",
    "--letter-spacing-nav": "0.05em",
    "--line-height-heading": "1",
    "--line-height-body":    "1.4"
  },

  "spacing": {
    "--section-padding-y-lg": "125px",
    "--section-padding-y-md": "85px",
    "--section-padding-y-sm": "65px",
    "--col-padding-y":        "5%",
    "--col-padding-x":        "3%",
    "--gap":                  "1rem",
    "--base-unit":            "4px"
  },

  "components": {
    "--radius-btn":       "0.35em",
    "--btn-padding-y":    "0.8em",
    "--btn-padding-x":    "1em",
    "--nav-padding-y":    "0.75em",
    "--nav-padding-x":    "0.75em"
  },

  "breakpoints": {
    "--bp-desktop":  "1920px",
    "--bp-tablet":   "978px",
    "--bp-mobile":   "766px",
    "--bp-xs":       "479px"
  },

  "motion": {
    "--transition-color": "color 0.2s ease",
    "--transition-bg":    "background-color 0.2s ease"
  }
}
